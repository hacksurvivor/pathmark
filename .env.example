PATHMARK_STORE_DIR=~/.pathmark/memory
PATHMARK_MAX_SEARCH_RESULTS=12
# PATHMARK_NAMESPACE=my-project
# PATHMARK_REDACT_MCP_WRITES=on
# PATHMARK_RETENTION_DAYS=0
# PATHMARK_INDEX_LOCK_TIMEOUT_MS=120000
# client = MCP client synthesizes from returned context.
# command = PATHMARK_CHAT_COMMAND receives prompt on stdin and returns answer on stdout.
# codex = use local Codex CLI subscription/auth bridge.
# openai-compatible = call /chat/completions on any compatible provider.
PATHMARK_SYNTHESIS_PROVIDER=client

# PATHMARK_CHAT_COMMAND=your-ai-cli --model your-model
# PATHMARK_CODEX_COMMAND=codex
# PATHMARK_CODEX_MODEL=gpt-5.5
# PATHMARK_OPENAI_BASE_URL=https://api.openai.com/v1
# PATHMARK_OPENAI_API_KEY=
# PATHMARK_OPENAI_MODEL=
# PATHMARK_CHAT_TIMEOUT_MS=120000

# Optional trusted local semantic/embedding reranker.
# Receives {query,candidates} JSON on stdin and returns ranked memory ids.
# PATHMARK_RERANK_COMMAND=your-local-reranker
# PATHMARK_HYBRID_CANDIDATES=500
# PATHMARK_RETRIEVAL_TIMEOUT_MS=30000

# Optional passphrase for AES-256-GCM portable exports/imports.
# PATHMARK_EXPORT_KEY=
