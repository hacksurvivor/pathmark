{
  "mcp": {
    "pathmark": {
      "type": "local",
      "command": ["pathmark"],
      "enabled": true,
      "environment": {
        "PATHMARK_STORE_DIR": "~/.pathmark/memory",
        "PATHMARK_SYNTHESIS_PROVIDER": "client"
      }
    }
  }
}

// Import an exported opencode transcript when automatic plugin hooks are not configured:
// pathmark ingest --client=opencode --namespace=my-project < transcript.json
